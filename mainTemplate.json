{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "clusterResourceName": {
      "type": "string",
      "metadata": {
        "description": "AKS cluster name"
      }
    },
    "extensionResourceName": {
      "type": "string",
      "metadata": {
        "description": "Extension instance name"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "externalDomain": {
      "type": "string",
      "defaultValue": "bdp.example.com"
    },
    "storageClass": {
      "type": "string",
      "defaultValue": ""
    },
    "postgresSizeGi": {
      "type": "string",
      "defaultValue": "20"
    },
    "redisSizeGi": {
      "type": "string",
      "defaultValue": "8"
    },
    "sharedDataSizeGi": {
      "type": "string",
      "defaultValue": "50"
    },
    "tlsMode": {
      "type": "string",
      "defaultValue": "existing",
      "allowedValues": [
        "acme",
        "existing"
      ],
      "metadata": {
        "description": "Where the TLS certificate comes from."
      }
    },
    "adminEmail": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Contact address for certificate expiry warnings."
      }
    },
    "tlsSecretName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Secret holding the platform TLS certificate."
      }
    }
  },
  "variables": {
    "clusterExtensionTypeName": "bluechiptech.bdp",
    "releaseTrain": "stable",
    "plan-name": "bdp-flat",
    "plan-publisher": "bluechiptech",
    "plan-offerID": "bdp"
  },
  "resources": [
    {
      "type": "Microsoft.KubernetesConfiguration/extensions",
      "apiVersion": "2024-11-01",
      "name": "[parameters('extensionResourceName')]",
      "scope": "[concat('Microsoft.ContainerService/managedClusters/', parameters('clusterResourceName'))]",
      "location": "[parameters('location')]",
      "plan": {
        "name": "[variables('plan-name')]",
        "publisher": "[variables('plan-publisher')]",
        "product": "[variables('plan-offerID')]"
      },
      "properties": {
        "extensionType": "[variables('clusterExtensionTypeName')]",
        "autoUpgradeMinorVersion": true,
        "releaseTrain": "[variables('releaseTrain')]",
        "configurationSettings": {
          "global.externalDomain": "[parameters('externalDomain')]",
          "global.storageClass": "[parameters('storageClass')]",
          "postgresql.primary.persistence.size": "[concat(parameters('postgresSizeGi'), 'Gi')]",
          "redis.master.persistence.size": "[concat(parameters('redisSizeGi'), 'Gi')]",
          "sharedStorage.size": "[concat(parameters('sharedDataSizeGi'), 'Gi')]",
          "global.tls.mode": "[parameters('tlsMode')]",
          "global.adminEmail": "[parameters('adminEmail')]",
          "global.tlsSecretName": "[parameters('tlsSecretName')]"
        },
        "scope": {
          "cluster": {
            "releaseNamespace": "bdp"
          }
        }
      }
    }
  ],
  "outputs": {
    "location": {
      "type": "string",
      "value": "[parameters('location')]"
    },
    "platformUrl": {
      "type": "string",
      "value": "[concat(if(empty(parameters('tlsSecretName')), 'http://', 'https://'), parameters('externalDomain'))]"
    },
    "nextStep_1_getIngressIp": {
      "type": "string",
      "value": "[concat('az aks command invoke -g <resource-group> -n ', parameters('clusterResourceName'), ' --command \"kubectl get svc -n bdp ingress-nginx-controller -o jsonpath={.status.loadBalancer.ingress[0].ip}\"')]"
    },
    "nextStep_2_createWildcardDns": {
      "type": "string",
      "value": "[concat('Create a WILDCARD DNS record  *.', parameters('externalDomain'), '  pointing at the IP from step 1. A single A record is not enough: sign-in is served at keycloak.', parameters('externalDomain'), ' and each data tool gets its own subdomain.')]"
    },
    "nextStep_3_getSignInPassword": {
      "type": "string",
      "value": "[concat('az aks command invoke -g <resource-group> -n ', parameters('clusterResourceName'), ' --command \"kubectl get secret bdp-credentials -n bdp -o jsonpath={.data.admin-password}\" | base64 -d   (username: admin)')]"
    }
  }
}
