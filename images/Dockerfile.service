# Generic runtime image for every BDP Spring Boot service.
# Build arg SERVICE selects the JAR; the image contains ONLY the fat JAR.
FROM eclipse-temurin:21-jre-jammy
ARG SERVICE
RUN useradd --system --uid 10001 --no-create-home bdp
COPY dist/lib/${SERVICE}.jar /app/app.jar
USER 10001
ENV JAVA_OPTS="-Xms256m -Xmx768m"
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /app/app.jar"]
