dist/
*.tgz
# charts/bdp/charts/ (the vendored, PATCHED subcharts) is deliberately
# COMMITTED: the patches make the subcharts read the global registry values,
# and `helm dependency build` would replace them with unpatched upstream
# copies. Committing them keeps every clone installable without the build
# host. The *.tgz ignore above must not catch them, hence the negation:
!charts/bdp/charts/**

# Build logs from build-all.sh / collect-artifacts.sh
*.log

# release.sh output: recorded digests + air-gap bundles (large binaries)
releases/

# `helm dependency update` output for the umbrella chart. Its charts/ dir is
# already ignored above, so the lockfile pinning it is an artifact too.
charts/bdp/Chart.lock

# Per-task agent reports — working notes, not deliverables.
.superpowers-task-*.md
